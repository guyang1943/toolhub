{
  "name": "toolhub",
  "version": "3.18.0",
  "private": true,
  "description": "ToolHub · 把开源工具变成打开即用的在线工具（零依赖静态站）",
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "build:prod": "node scripts/build-pages.mjs https://toolhub.bot.cd",
    "lint": "node scripts/lint-tools.mjs",
    "verify": "node scripts/verify.mjs",
    "test:spa": "node scripts/spa-render-test.mjs",
    "test:func": "node scripts/new-tools-test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "serve": "node scripts/serve.mjs",
    "serve:fresh": "node scripts/serve.mjs --port 8765 --no-sw",
    "perf": "node scripts/perf-budget.mjs",
    "health": "node scripts/health-check.mjs",
    "audit": "node scripts/audit.mjs",
    "check": "node scripts/check-all.mjs",
    "check:meta": "node scripts/check-tool-meta.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:submit": "node scripts/check-submit-schema.mjs",
    "idem": "node scripts/check-idempotent.mjs",
    "online": "node scripts/verify-online.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "test:flow": "node scripts/workflow-test.mjs",
    "gen:llms": "node scripts/gen-llms-txt.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "//": "没有 \"type\": \"module\" 是刻意的：assets/vendor 下的库是 UMD/传统脚本，Node 侧靠 22+ 的语法检测识别 ESM，两者互不干扰。"
}
